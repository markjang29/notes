#!/usr/bin/env python3
"""Taiga ↔ 승인보드(8005) 게이트 브릿지.
- Taiga 스토리가 설계승인대기/이사님승인 상태가 되면 승인보드(decisions.json)에 카드 생성
- 이사님이 보드에서 O/X 판정 → Taiga 상태 자동 전이 (설계승인대기→구현/설계, 이사님승인→배포/구현)
- 테스트봇검증: tester.py가 결과 요약 카드를 만들고 이사님승인으로 전이
20초 폴링, 처리 상태는 state.json에 기록(멱등)."""
import json
import os
import time
import urllib.request
import urllib.error
from datetime import datetime
from pathlib import Path

DECISIONS = Path(os.path.expanduser("~/projects/approval-board/decisions.json"))

# GOV#24 [G3]: 승인보드 파일 경합 제거 — 승인보드 앱의 request_store(파일잠금+원자교체)를 빌려 쓴다.
import sys
sys.path.insert(0, "/home/smlime21/projects/approval-board")
from request_store import transact_json
STATE = Path(os.path.expanduser("~/.config/taiga-bridge/state.json"))
LOG = lambda msg: print(f"{datetime.now():%m-%d %H:%M:%S} {msg}", flush=True)

# GOV#28(G6): 타이가 클라이언트 공통모듈로 단일화 — def taiga 복붙 제거, 로컬우선·파일잠금 내장
import taiga_common
from taiga_common import taiga, SLUGS, GATE_OF_STATUS
def reauth():
    # GOV#28(G6): 재인증·저장은 taiga_common(_relogin — 잠금내 저장)으로 단일화. 호환용 래퍼(호출 0 — 시험용).
    import taiga_common as _tc
    _tc._relogin(_tc._load_creds())
    LOG("token refreshed (via taiga_common)")

def load_state():
    return json.loads(STATE.read_text()) if STATE.exists() else {"processed": {}}

def save_state(s):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(s, ensure_ascii=False, indent=1))

def board_items():
    return json.loads(DECISIONS.read_text()) if DECISIONS.exists() else {"items": []}

def board_save(d):
    # GOV#24 [G3]: 무잠금 덮어쓰기(사본 유실 위험) → 잠금 후 "최신본 + 신규카드 병합" 원자 저장.
    # add-only 병합: bridge·tester는 카드 '추가'만 하므로, 같은 id면 보드 측(이사님 판정)을 최신으로 존중.
    def _merge(fresh):
        have = {i.get("id") for i in fresh.get("items", [])}
        add = [i for i in d.get("items", []) if i.get("id") not in have]
        fresh.setdefault("items", [])
        fresh["items"] = add + fresh["items"]     # 신규 카드는 상단(기존 insert(0, ·) 의미 유지)
        return fresh
    transact_json(DECISIONS, {"items": []}, _merge)

def roster_display():
    """roster 원장에서 username → 표시명. 실패 시 빈 매핑."""
    try:
        import pathlib
        r = json.loads(pathlib.Path.home().joinpath("notes/projects/agent-ops/roster.json").read_text())
        return {b["username"]: b.get("display", "") for b in r.get("bots", [])}
    except Exception:
        return {}


def ensure_card(d, state, ref, subject, gate, slug, link, summary, bot=None):
    if any(i.get("taiga_ref") == ref for i in d["items"]):
        return
    disp = roster_display().get((bot or "").lstrip("@"), "")
    owner_line = f"담당봇: {bot} ({disp})\n" if bot else "담당봇: 미지정\n"
    card = {
        "id": f"gate-{int(time.time()*1000)}-{ref.replace(':','-')}",
        "kind": "taiga_gate", "taiga_ref": ref, "gate": gate,
        "title": f"[{gate}] {subject}",
        "body": f"{owner_line}\n{summary or ''}\n\n티켓: {link}",
        "status": "pending", "comment": "", "client": "taiga-bridge",
        "log": [{"ts": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                 "msg": f"taiga gate card created ({gate})"}],
        "created_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    }
    d["items"].insert(0, card)
    LOG(f"카드 생성 [{gate}] {subject[:30]}")

def main():
    LOG("bridge start")
    while True:
        try:
            state = load_state()
            d = board_items()
            changed = False
            for pid, slug in SLUGS.items():
                statuses = {s["id"]: s["name"] for s in taiga("GET", f"/userstory-statuses?project={pid}")}
                rev = {}
                for sid, n in statuses.items():
                    rev.setdefault(n, sid)
                for u in taiga("GET", f"/userstories?project={pid}&page_size=100"):
                    st = statuses.get(u["status"], "")
                    if st not in GATE_OF_STATUS:
                        continue
                    det = taiga("GET", f"/userstories/{u['id']}")
                    attrs = taiga("GET", f"/userstories/custom-attributes-values/{u['id']}").get("attributes_values", {})
                    defs = {a["id"]: a["name"] for a in taiga("GET", f"/userstory-custom-attributes?project={pid}")}
                    bot = next((v for k, v in attrs.items() if defs.get(int(k)) == "담당봇"), "")
                    ref = f"{pid}:{u['id']}"
                    link = taiga_common.us_link(pid, u["ref"])
                    ensure_card(d, state, ref, u["subject"], GATE_OF_STATUS[st], slug, link,
                                (det.get("description") or "")[:300], bot)
                    changed = True
            if changed:
                board_save(d)
            # 판정 처리
            d = board_items()
            moved = False
            for item in d["items"]:
                if item.get("kind") not in ("taiga_gate", "taiga_test"):
                    continue
                if item.get("status") not in ("approved", "rejected", "deferred"):
                    continue
                if state["processed"].get(item["id"]):
                    continue
                pid, sid = item["taiga_ref"].split(":")
                pid, sid = int(pid), int(sid)
                statuses = {s["name"]: s["id"] for s in taiga("GET", f"/userstory-statuses?project={pid}")}
                det = taiga("GET", f"/userstories/{sid}")
                gate = item.get("gate")
                verdict = item["status"]
                label = {"approved": "승인", "rejected": "기각", "deferred": "보류"}[verdict]
                if verdict == "approved":
                    newst = "구현" if gate == "설계승인" else "배포"
                elif verdict == "rejected":
                    newst = "설계" if gate == "설계승인" else "구현"
                else:
                    newst = None
                cmt = item.get("comment", "")
                if cmt:  # 폼 인코딩 mojibake(ë°) 복원 시도
                    try:
                        fixed = cmt.encode("latin-1").decode("utf-8")
                        if "�" not in fixed and any(ord(ch) > 127 for ch in fixed):
                            cmt = fixed
                    except Exception:
                        pass
                note = f"[게이트 {gate}] 이사님 판정: {label}" + (f" — {cmt}" if cmt else "")
                if newst:
                    taiga("PATCH", f"/userstories/{sid}",
                          {"status": statuses[newst], "version": det["version"]})
                # 판정 기록: 설명 꼬리에 한 줄 추가 (댓글 API 부재)
                newdesc = (det.get("description") or "") + f"\n\n`{datetime.now():%m-%d %H:%M} {note}`"
                taiga("PATCH", f"/userstories/{sid}", {"description": newdesc, "version": det["version"]})
                state["processed"][item["id"]] = datetime.now().isoformat()
                LOG(f"판정 반영 {item['taiga_ref']} {gate} {label} → {newst}")
                moved = True
            if moved:
                save_state(state)
        except Exception as ex:
            LOG(f"error: {ex}")
        time.sleep(20)

if __name__ == "__main__":
    main()
