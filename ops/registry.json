  "assignment_contract": {
    "authority": "director",
    "record": "target-repository:WORK.md",
    "registry_grants_authority": false,
    "one_writer_per_task": true,
    "expires_with_task": true,
    "delegation_requires_explicit_grant": true,
    "runtime_capability_revalidation": true,
    "required_fields": [
      "task_id",
      "role_id",
      "executor_ref",
      "assigned_by",
      "objective",
      "project",
      "repo_id",
      "base_commit",
      "branch",
      "allowed",
      "read_scope",
      "write_scope",
      "forbidden",
      "done_when",
      "evidence_required",
      "test_plan",
      "reviewer",
      "expires_at"
    ],
    "effective_access": {
      "all_must_allow": [
        "role.grants",
        "environment.supports",
        "WORK.allowed"
      ],
      "deny_overrides": [
        "role.prohibitions",
        "environment.hard_limits",
        "WORK.forbidden"
      ],
      "repository_gate_must_pass": true
    },
    "lifecycle": [
      "assigned",
      "working",
      "review",
      "done",
      "blocked",
      "cancelled"
    ]
  },
  "user_statuses": [
    "결정 필요",
    "직접 테스트 필요",
    "반영 완료",
    "막힘"
