      "delete legacy registry or schemas",
      "assign production work from this shadow registry",
      "restart automation",
      "rotate credentials",
      "rewrite Git history"
    ],
    "remove_after_cutover": [
      "legacy_actor_aliases",
      "legacy_registry_ref",
      "legacy_boot_ref"
    ]
